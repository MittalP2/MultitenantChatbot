# Cursor SDK — get a key from https://cursor.com/dashboard/integrations
# CURSOR_API_KEY=cursor_your-key-here
# CURSOR_MODEL=composer-2.5
# CURSOR_RUNTIME=cloud   # cloud (default, Windows-safe) or local

# Optional later — when set, OpenAI is tried after Cursor
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional local LLM (install from https://ollama.com then: ollama pull llama3.2)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
